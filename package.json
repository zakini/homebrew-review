{
  "name": "brew-review",
  "version": "0.1.0",
  "description": "Review your installed Homebrew packages and remove the ones you no longer use",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zakini/homebrew-review.git"
  },
  "bin": {
    "brew-review": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^24"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "^11.14.1",
      "onFail": "error"
    }
  },
  "packageManager": "npm@11.14.1",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "dev:watch": "tsx watch src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@commander-js/extra-typings": "^15.0.0",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@tsconfig/node24": "^24.0.5",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^24.19.0",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
